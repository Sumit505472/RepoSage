REPOSAGE_APP_NAME=RepoSage
REPOSAGE_ENVIRONMENT=development
REPOSAGE_CORS_ORIGINS=["http://localhost:5173"]
# Optional. Public repositories can be indexed without a token.
# REPOSAGE_GITHUB_TOKEN=
REPOSAGE_GITHUB_API_TIMEOUT_SECONDS=20
REPOSAGE_MAX_REPOSITORY_FILES=1000
REPOSAGE_MAX_FILE_SIZE_BYTES=1000000
REPOSAGE_MAX_TOTAL_SOURCE_BYTES=10000000
REPOSAGE_CHUNK_SIZE_LINES=100
REPOSAGE_CHUNK_OVERLAP_LINES=15
REPOSAGE_MAX_REPOSITORY_CHUNKS=10000
REPOSAGE_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
REPOSAGE_RETRIEVAL_CANDIDATE_COUNT=50
REPOSAGE_RETRIEVAL_RRF_K=60
